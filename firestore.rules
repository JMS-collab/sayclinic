rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /medical_records/{recordId} {
      allow read, write: if true;
    }
    match /patients/{patientId} {
      allow read, write: if true;
    }
    match /clinic_settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
